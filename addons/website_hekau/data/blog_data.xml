<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The blog, its author and its topics: created once, then managed in
         Website > Blog like any post. The articles are in blog_posts.xml. -->
    <data noupdate="1">

        <record id="website_blog.blog_blog_1" model="blog.blog">
            <field name="name">Hekau Blog</field>
            <field name="subtitle">Insights from the Hekau team.</field>
            <field name="website_meta_description">Practical articles for founders and operations leaders on connected systems, ERP, automation and AI that actually gets used.</field>
        </record>

        <!-- Author of the articles (an existing contact or user named
             Santosh Yadav is used instead when upgrading) -->
        <record id="blog_author_santosh" model="res.partner">
            <field name="name">Santosh Yadav</field>
            <field name="function">Director &amp; Co-Founder</field>
            <field name="image_1920" type="base64" file="website_hekau/static/src/img/about/founder_santosh.webp"/>
        </record>

        <!-- Each article has one Topic (shown above its title in the blog
             and used to filter posts) and a few Keywords tags. -->
        <record id="blog_tag_category_topics" model="blog.tag.category">
            <field name="name">Topics</field>
        </record>
        <record id="blog_tag_category_keywords" model="blog.tag.category">
            <field name="name">Keywords</field>
        </record>

        <record id="blog_topic_connected_systems" model="blog.tag">
            <field name="name">Connected Systems</field>
            <field name="category_id" ref="blog_tag_category_topics"/>
        </record>
        <record id="blog_topic_erp_manufacturing" model="blog.tag">
            <field name="name">ERP &amp; Manufacturing</field>
            <field name="category_id" ref="blog_tag_category_topics"/>
        </record>
        <record id="blog_topic_automation_ai" model="blog.tag">
            <field name="name">Automation &amp; AI</field>
            <field name="category_id" ref="blog_tag_category_topics"/>
        </record>
        <record id="blog_topic_leadership_strategy" model="blog.tag">
            <field name="name">Leadership &amp; Strategy</field>
            <field name="category_id" ref="blog_tag_category_topics"/>
        </record>
        <record id="blog_topic_websites_platforms" model="blog.tag">
            <field name="name">Websites &amp; Platforms</field>
            <field name="category_id" ref="blog_tag_category_topics"/>
        </record>

    </data>
</odoo>
