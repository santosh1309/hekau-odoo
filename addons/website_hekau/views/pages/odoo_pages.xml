    <template id="contactus_hekau" inherit_id="website.contactus" name="Hekau Contact Us" priority="99">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure hk-page">
                <section class="s_hk_contact" data-snippet="s_hk_contact" data-name="Hekau Contact">
                    <div class="hk-hero-art hk-deco o_not_editable" aria-hidden="true">
                        <div class="hk-hero-stage">
                            <span class="hk-hero-ellipse"/>
                            <span class="hk-hero-panel"/>
                        </div>
                        <span class="hk-hero-fade"/>
                    </div>
                    <div class="hk-container hk-contact-row">
                        <div class="hk-contact-copy">
                            <span class="hk-badge">Contact</span>
                            <h1 class="hk-contact-title">Let’s find what’s slowing you down</h1>
                            <p class="hk-contact-text">Tell us a little about your business. We’ll reply within one business day to set up your free systems audit.</p>
                            <ul class="hk-contact-details">
                                <li><span>Email</span><a href="mailto:admin@hekautech.com">admin@hekautech.com</a></li>
                                <li><span>Phone</span><a href="tel:+918149749282">+91 81497 49282</a></li>
                                <li><span>Office</span>Vijayashree, S. No. 33/92, near MSEB Office, Katraj, Pune 411046</li>
                                <li><span>LinkedIn</span><a href="https://www.linkedin.com/company/hekaubiz" target="_blank" rel="noopener">Hekau Business Solutions</a></li>
                            </ul>
                        </div>
                        <div class="hk-contact-panel">
                            <div class="s_website_form" data-snippet="s_website_form" data-vcss="001" data-name="Form">
                                <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required hk-form" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                    <div class="s_website_form_rows hk-form-grid">
                                        <div class="s_website_form_field hk-form-field s_website_form_required" data-type="char" data-name="Field">
                                            <label class="s_website_form_label" for="hk_contact_name"><span class="s_website_form_label_content">Name</span><span class="s_website_form_mark"> *</span></label>
                                            <input id="hk_contact_name" type="text" class="form-control s_website_form_input" name="contact_name" required="" autocomplete="name" data-fill-with="name"/>
                                        </div>
                                        <div class="s_website_form_field hk-form-field s_website_form_required" data-type="email" data-name="Field">
                                            <label class="s_website_form_label" for="hk_email"><span class="s_website_form_label_content">Work email</span><span class="s_website_form_mark"> *</span></label>
                                            <input id="hk_email" type="email" class="form-control s_website_form_input" name="email_from" required="" autocomplete="email" data-fill-with="email"/>
                                        </div>
                                        <div class="s_website_form_field hk-form-field" data-type="tel" data-name="Field">
                                            <label class="s_website_form_label" for="hk_phone"><span class="s_website_form_label_content">Phone</span></label>
                                            <input id="hk_phone" type="tel" class="form-control s_website_form_input" name="phone" autocomplete="tel" data-fill-with="phone"/>
                                        </div>
                                        <div class="s_website_form_field hk-form-field s_website_form_required" data-type="char" data-name="Field">
                                            <label class="s_website_form_label" for="hk_company"><span class="s_website_form_label_content">Company</span><span class="s_website_form_mark"> *</span></label>
                                            <input id="hk_company" type="text" class="form-control s_website_form_input" name="partner_name" required="" autocomplete="organization" data-fill-with="commercial_company_name"/>
                                        </div>
                                        <div class="s_website_form_field hk-form-field s_website_form_custom" data-type="many2one" data-name="Field">
                                            <label class="s_website_form_label" for="hk_revenue"><span class="s_website_form_label_content">Annual revenue</span></label>
                                            <select id="hk_revenue" class="form-select s_website_form_input" name="Annual revenue"><option value="" class="s_website_form_empty_option">Choose one</option><option value="Under $2M">Under $2M</option><option value="$2M–$15M">$2M–$15M</option><option value="Above $15M">Above $15M</option><option value="Prefer not to say">Prefer not to say</option></select>
                                        </div>
                                        <div class="s_website_form_field hk-form-field s_website_form_custom s_website_form_required" data-type="many2one" data-name="Field">
                                            <label class="s_website_form_label" for="hk_service"><span class="s_website_form_label_content">What do you need help with?</span><span class="s_website_form_mark"> *</span></label>
                                            <select id="hk_service" class="form-select s_website_form_input" name="Service needed" required=""><option value="" class="s_website_form_empty_option">Choose one</option><option value="ERP, CRM &amp; CMS Implementation">ERP, CRM &amp; CMS Implementation</option><option value="Workflow &amp; Process Automation">Workflow &amp; Process Automation</option><option value="Custom Web Applications &amp; B2B Portals">Custom Web Applications &amp; B2B Portals</option><option value="Secure In-House AI &amp; Data">Secure In-House AI &amp; Data</option><option value="Mobile App Development">Mobile App Development</option><option value="UX &amp; Conversion-Focused Websites">UX &amp; Conversion-Focused Websites</option><option value="Cloud-Managed Services">Cloud-Managed Services</option><option value="Project Rescue &amp; Dedicated Developers">Project Rescue &amp; Dedicated Developers</option><option value="Not sure yet">Not sure yet</option></select>
                                        </div>
                                        <div class="s_website_form_field hk-form-field s_website_form_required hk-form-wide" data-type="text" data-name="Field">
                                            <label class="s_website_form_label" for="hk_description"><span class="s_website_form_label_content">What’s slowing your business down?</span><span class="s_website_form_mark"> *</span></label>
                                            <textarea id="hk_description" class="form-control s_website_form_input" name="description" required="" rows="5"></textarea>
                                        </div>
                                        <div class="s_website_form_field hk-form-field s_website_form_custom hk-form-wide" data-type="many2one" data-name="Field">
                                            <label class="s_website_form_label" for="hk_source"><span class="s_website_form_label_content">How did you hear about us?</span></label>
                                            <select id="hk_source" class="form-select s_website_form_input" name="Heard about us via"><option value="" class="s_website_form_empty_option">Choose one</option><option value="LinkedIn">LinkedIn</option><option value="Google">Google</option><option value="Referral">Referral</option><option value="Event">Event</option><option value="Other">Other</option></select>
                                        </div>
                                        <div class="s_website_form_field s_website_form_custom hk-form-field hk-form-check s_website_form_required" data-type="boolean" data-name="Field">
                                            <label class="s_website_form_label" for="hk_consent"><span class="s_website_form_label_content">Hekau may contact me about this enquiry. See <a href="/privacy">the privacy policy</a>.</span><span class="s_website_form_mark"> *</span></label>
                                            <input id="hk_consent" type="checkbox" value="Yes" class="s_website_form_input form-check-input" name="Contact consent" required=""/>
                                        </div>
                                        <div class="s_website_form_field s_website_form_custom hk-form-field hk-form-check" data-type="boolean" data-name="Field">
                                            <label class="s_website_form_label" for="hk_newsletter"><span class="s_website_form_label_content">Send me the System Disconnection Checklist and occasional insights. Unsubscribe anytime.</span></label>
                                            <input id="hk_newsletter" type="checkbox" value="Yes" class="s_website_form_input form-check-input" name="Newsletter opt-in"/>
                                        </div>
                                        <div class="s_website_form_field s_website_form_dnone" data-type="char" data-name="Field">
                                            <label class="s_website_form_label"><span class="s_website_form_label_content">Lead title</span></label>
                                            <input type="hidden" class="form-control s_website_form_input" name="name" value="Website enquiry: free systems audit"/>
                                        </div>
                                        <div class="s_website_form_submit s_website_form_no_submit_label text-start hk-form-submit" data-name="Submit Button">
                                            <span id="s_website_form_result"></span>
                                            <a href="#" role="button" class="btn btn-primary s_website_form_send hk-btn hk-btn-primary">Book my free systems audit</a>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            <p class="hk-contact-aside">Rather pick a time now? <a href="/book-a-call">Book a 30-minute call</a>. Prefer to talk? Call <a href="tel:+918149749282">+91 81497 49282</a> or message <a href="https://www.linkedin.com/in/santosh-yadav-hekau/" target="_blank" rel="noopener">Santosh on LinkedIn</a>.</p>
                        </div>
                    </div>
                </section>
                <section id="testimonials" class="s_hk_testimonials hk-section hk-testimonials-pair" data-snippet="s_hk_testimonials" data-name="Hekau Testimonials" style="--hk-pt: 120px; --hk-pt-m: 96px;">
                    <div class="hk-container">
                        <div class="hk-testimonials-box">
                            <div class="hk-testimonials-head">
                                <span class="hk-badge">In our clients’ words</span>
                                <h2 class="hk-h2">What working with <br class="hk-only-mobile"/>us is like</h2>
                                <p class="hk-lead">From the companies we build and fix systems for.</p>
                            </div>
                            <div class="hk-quotes hk-scroller" tabindex="0" aria-label="Client testimonials">
                                <figure class="hk-quote m-0">
                                    <header>
                                        <img src="/website_hekau/static/src/img/testimonials/aditi_shrivastava.webp" alt="Aditi Shrivastava" width="48" height="48" loading="lazy"/>
                                        <div>
                                            <h3>Aditi Shrivastava</h3>
                                            <p class="hk-quote-role">Co-founder, The Arc</p>
                                        </div>
                                    </header>
                                    <blockquote>“Working with the Hekau team has been a great experience. They quickly understood our vision at The Arc and turned it into practical digital solutions. I really appreciate their professionalism, flexibility, and focus on delivering results.”</blockquote>
                                </figure>
                                <figure class="hk-quote m-0">
                                    <header>
                                        <img src="/website_hekau/static/src/img/testimonials/ismail_shaikh.webp" alt="Ismail Shaikh" width="48" height="48" loading="lazy"/>
                                        <div>
                                            <h3>Ismail Shaikh</h3>
                                            <p class="hk-quote-role">Co-founder, FYHBA Medical Billing</p>
                                        </div>
                                    </header>
                                    <blockquote>“Hekau has been an excellent partner for FYHBA. They not only understood our requirements clearly but also went the extra mile to deliver solutions that added real value to our business. Their proactive approach, attention to detail, and dependable support have made them a trusted partner for us.”</blockquote>
                                </figure>
                            </div>
                            <div class="hk-scroll-indicator hk-only-mobile" aria-hidden="true"><span/></div>
                            <div class="hk-quotes-nav hk-only-desktop">
                                <button type="button" class="hk-arrow-btn hk-arrow-prev" aria-label="Previous testimonial"><img src="/website_hekau/static/src/img/icons/arrow_right_16.svg" alt="" width="16" height="16"/></button>
                                <button type="button" class="hk-arrow-btn hk-arrow-next" aria-label="Next testimonial"><img src="/website_hekau/static/src/img/icons/arrow_right_16.svg" alt="" width="16" height="16"/></button>
                            </div>
