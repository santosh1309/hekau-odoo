<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Key figures (Figma "Frame 5027"). The Figma mobile frame leaves this
         section out, so it is hidden below 768px. -->
    <template id="s_hk_stats" name="Hekau Stats">
        <section class="s_hk_stats hk-section" data-name="Hekau Stats">
            <div class="hk-section-head hk-glow-box">
                <h2 class="hk-subhead">Our Long-Term Partners</h2>
            </div>
            <div class="hk-container">
                <div class="hk-stats-row">
                    <div class="hk-stat">
                        <p class="hk-stat-value">50k+</p>
                        <p class="hk-stat-label">Monthly Visitors Attracted to Client Page</p>
                    </div>
                    <div class="hk-stat">
                        <p class="hk-stat-value">12%</p>
                        <p class="hk-stat-label">Customer Retention Rate</p>
                    </div>
                    <div class="hk-stat">
                        <p class="hk-stat-value">12k+</p>
                        <p class="hk-stat-label">Users On Launch Day For Client Website</p>
                    </div>
                    <div class="hk-stat">
                        <p class="hk-stat-value">20+</p>
                        <p class="hk-stat-label">Clients Across The Globe</p>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
