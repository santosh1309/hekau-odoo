<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Key figures (Figma "Frame 5027"), each from a case study. The Figma
         mobile frame leaves this section out, so it is hidden below 768px. -->
    <template id="s_hk_stats" name="Hekau Stats">
        <section class="s_hk_stats hk-section" data-name="Hekau Stats">
            <div class="hk-section-head hk-glow-box">
                <h2 class="hk-subhead">Proof in numbers</h2>
            </div>
            <div class="hk-container">
                <div class="hk-stats-row">
                    <div class="hk-stat">
                        <p class="hk-stat-value">50,000+</p>
                        <p class="hk-stat-label">Monthly visitors on The Arc, the media platform we rescued and rebuilt</p>
                    </div>
                    <div class="hk-stat">
                        <p class="hk-stat-value">70%</p>
                        <p class="hk-stat-label">Faster CSR campaigns at Inali Foundation: from 7 days to 2</p>
                    </div>
                    <div class="hk-stat">
                        <p class="hk-stat-value">+30%</p>
                        <p class="hk-stat-label">High-intent B2B leads for MaxintelB2B after their website rebuild</p>
                    </div>
                    <div class="hk-stat">
                        <p class="hk-stat-value">6,000</p>
                        <p class="hk-stat-label">Regular users on an event ticketing platform we built</p>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
