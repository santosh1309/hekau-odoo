<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hero with the Figma "Background Animation": a still layer (grid + light
         rays), the blue/gold glow spinning on its centre (90deg per 4s), a dark
         panel fading in and out, and a fade to navy at the bottom. -->
    <template id="s_hk_hero" name="Hekau Hero">
        <section class="s_hk_hero" data-name="Hekau Hero">
            <div class="hk-hero-art hk-deco o_not_editable" aria-hidden="true">
                <div class="hk-hero-stage">
                    <span class="hk-hero-ellipse"/>
                    <span class="hk-hero-panel"/>
                </div>
                <span class="hk-hero-fade"/>
            </div>
            <div class="hk-hero-content">
                <h1>Fix the <span class="hk-gradient-text">fragmented systems</span> <br/>slowing down your growth</h1>
                <p class="hk-hero-text">Most $2M–$15M companies don’t have a software problem. They have a fragmented systems problem. We connect your ERP, CRM, workflows and data, so decisions run on today’s numbers, not last week’s spreadsheet.</p>
                <a href="/book-a-call" class="hk-btn hk-btn-quote">Book a free systems audit</a>
                <a href="/website_hekau/static/src/files/hekau-system-disconnection-checklist.pdf" class="hk-hero-link" download="">Or download the System Disconnection Checklist</a>
            </div>
        </section>
    </template>

</odoo>
