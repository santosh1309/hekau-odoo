<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Why partner with Hekau (Figma "Frame 5016" + "Hekau Animation").
         The two cursor/tag groups move between three positions on a bouncy
         spring (1.25s each, 0.2/0.2/0.25s pauses). On mobile the cards become a
         swipeable row with a scroll indicator. -->
    <template id="s_hk_why" name="Hekau Why Partner">
        <section id="why-hekau" class="s_hk_why hk-section" data-name="Hekau Why Partner">
            <div class="hk-container">
                <div class="hk-why-row">
                    <div class="hk-why-visual">
                        <div class="hk-why-head">
                            <h2 class="hk-h2">Why growing companies choose Hekau</h2>
                            <p class="hk-why-sub hk-only-mobile">Technology should remove friction, not add it</p>
                        </div>
                        <div class="hk-squares-box hk-deco o_not_editable" aria-hidden="true">
                            <div class="hk-squares">
                                <span class="hk-sq hk-sq-1"/><span class="hk-sq hk-sq-2"/><span class="hk-sq hk-sq-3"/><span class="hk-sq hk-sq-4"/>
                                <span class="hk-sq hk-sq-5"/><span class="hk-sq hk-sq-6"/><span class="hk-sq hk-sq-7"/>
                                <img class="hk-sq-logo" src="/website_hekau/static/src/img/logo_mark_anim.svg" alt="" width="44" height="44"/>
                                <div class="hk-sq-group hk-sq-business">
                                    <img class="hk-cursor" src="/website_hekau/static/src/img/icons/cursor_pink.svg" alt="" width="28" height="28"/>
                                    <span class="hk-tag">Clarity</span>
                                </div>
                                <div class="hk-sq-group hk-sq-growth">
                                    <span class="hk-tag">Speed</span>
                                    <img class="hk-cursor" src="/website_hekau/static/src/img/icons/cursor_purple.svg" alt="" width="28" height="28"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="hk-why-cards-wrap">
                        <div class="hk-why-cards hk-scroller">
                            <div class="hk-why-card">
                                <h3 class="hk-why-title"><img src="/website_hekau/static/src/img/icons/why_bulb.svg" alt="" width="36" height="36"/>We start with the business, not the software</h3>
                                <p>Before we suggest a tool, we map how work actually moves through your company: who waits on whom, where the spreadsheets live, which numbers nobody trusts. Sometimes the fix is an ERP. Sometimes it’s one automation.</p>
                            </div>
                            <div class="hk-why-card">
                                <h3 class="hk-why-title"><img src="/website_hekau/static/src/img/icons/why_growth.svg" alt="" width="36" height="36"/>One system, one version of the truth</h3>
                                <p>We connect sales, operations, inventory and finance so every team works from the same numbers. Odoo where it fits, custom software where it doesn’t, and integrations that keep the two in sync.</p>
                            </div>
                            <div class="hk-why-card">
                                <h3 class="hk-why-title"><img src="/website_hekau/static/src/img/icons/why_money.svg" alt="" width="36" height="36"/>Accountable long after launch</h3>
                                <p>Your team has to actually use what we build. We train them, stay on for support, and measure success by the friction we remove, not the features we ship. What you’re quoted is what you pay.</p>
                            </div>
                        </div>
                        <div class="hk-scroll-indicator hk-only-mobile" aria-hidden="true"><span/></div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
