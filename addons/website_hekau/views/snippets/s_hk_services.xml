<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Services grid (Figma "Frame 1594" + "Component 527" cards).
         Hover (0.4s ease-out): the blue circle fills the card, text and button
         slide up 56px, "Learn More" turns navy. On mobile the button row is
         always visible. -->
    <template id="s_hk_services" name="Hekau Services">
        <section id="services" class="s_hk_services hk-section" data-name="Hekau Services">
            <div class="hk-container">
                <div class="hk-section-head hk-glow-top">
                    <h2 class="hk-h2">Services That Drive Innovation and Growth</h2>
                    <p class="hk-lead hk-lead-15 hk-only-desktop">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua</p>
                    <p class="hk-lead hk-lead-15 hk-only-mobile">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt</p>
                </div>
                <div class="hk-service-grid">
                    <div class="hk-service-card hk-service-narrow">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_web.svg" alt="" width="44" height="44"/>
                            <h3 class="hk-nowrap">Web Application Development</h3>
                        </div>
                        <p class="hk-service-text">Web applications are the backbone of any business. Hekau designs scalable, user-centric web apps that are functional and visually pleasing across all platforms.</p>
                        <div class="hk-service-actions">
                            <span>View Projects</span>
                            <a class="hk-service-more" href="/web-application-development">Learn More</a>
                        </div>
                    </div>
                    <div class="hk-service-card">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_mobile.svg" alt="" width="44" height="44"/>
                            <h3 class="hk-nowrap">Mobile Application Development</h3>
                        </div>
                        <p class="hk-service-text">Mobile apps serve as constant companions for both customers and employees — driving retention, boosting collaboration, and reinforcing brand loyalty across iOS and Android platforms.</p>
                        <div class="hk-service-actions">
                            <span>View Projects</span>
                            <a class="hk-service-more" href="/mobile-application-development">Learn More</a>
                        </div>
                    </div>
                    <div class="hk-service-card hk-service-narrow">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_ux.svg" alt="" width="44" height="44"/>
                            <h3 class="hk-nowrap">UX/UI Design</h3>
                        </div>
                        <p class="hk-service-text">With endless choices, customers return for intuitive experiences. We design interfaces that make every interaction effortless and goal-driven.</p>
                        <div class="hk-service-actions">
                            <span>View Projects</span>
                            <a class="hk-service-more" href="/ux-ui-design">Learn More</a>
                        </div>
                    </div>
                    <div class="hk-service-card hk-service-narrow">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_cloud.svg" alt="" width="44" height="44"/>
                            <h3>Cloud-Managed Services</h3>
                        </div>
                        <p class="hk-service-text">Cloud-powered businesses benefit from lower costs, on-demand scalability, and advanced security. Whether migrating or optimizing, we handle complexities so you can focus on growth.</p>
                        <div class="hk-service-actions">
                            <span>View Projects</span>
                            <a class="hk-service-more" href="/cloud-managed-services">Learn More</a>
                        </div>
                    </div>
                    <div class="hk-service-card">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_bpa.svg" alt="" width="44" height="44"/>
                            <h3>Business Process Automation</h3>
                        </div>
                        <p class="hk-service-text">Repetitive tasks will bog you down. Hekau automates the essential but time-consuming processes so you can turn your most creative endeavours into reality.</p>
                        <div class="hk-service-actions">
                            <span>View Projects</span>
                            <a class="hk-service-more" href="/business-process-automation">Learn More</a>
                        </div>
                    </div>
                    <div class="hk-service-card hk-service-narrow hk-service-tight">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_ai.svg" alt="" width="44" height="44"/>
                            <h3>AI for business</h3>
                        </div>
                        <p class="hk-service-text">AI solutions train on your business data and customer interactions. Use it to solve unique customer queries or get a personal assistant.</p>
                        <div class="hk-service-actions">
                            <span>View Projects</span>
                            <a class="hk-service-more" href="/ai-solutions">Learn More</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
