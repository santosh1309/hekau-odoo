<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Services grid (Figma "Frame 1594" + "Component 527" cards): eight cards,
         three per row with the last row centred.
         Hover (0.4s ease-out): the blue circle fills the card, text and button
         slide up 56px, "Learn more" turns navy. On mobile the button row is
         always visible. "View projects" opens the Projects page filtered to
         the service (?filter= matches a filter key of the Project List). -->
    <template id="s_hk_services" name="Hekau Services">
        <section id="services" class="s_hk_services hk-section" data-name="Hekau Services">
            <div class="hk-container">
                <div class="hk-section-head hk-glow-top">
                    <h2 class="hk-h2">What we build and fix</h2>
                    <p class="hk-lead hk-lead-15">Eight ways we remove friction from a growing company, from one automation to a full ERP rollout. Every engagement starts with a free systems audit.</p>
                </div>
                <div class="hk-service-grid">
                    <div class="hk-service-card">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_erp.svg" alt="" width="44" height="44"/>
                            <h3>ERP, CRM &amp; CMS Implementation</h3>
                        </div>
                        <p class="hk-service-text">Operations, sales and your website on systems that share the same data. We implement ERP, CRM and CMS platforms, Odoo first, so nobody re-types an order again.</p>
                        <div class="hk-service-actions">
                            <a class="hk-service-projects" href="/projects?filter=erp">View projects</a>
                            <a class="hk-service-more" href="/erp-crm-implementation">Learn more</a>
                        </div>
                    </div>
                    <div class="hk-service-card">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_bpa.svg" alt="" width="44" height="44"/>
                            <h3>Workflow &amp; Process Automation</h3>
                        </div>
                        <p class="hk-service-text">Approvals, follow-ups, reports and data entry that run themselves. We automate the steps your team works around today, starting with the ones that cost the most time.</p>
                        <div class="hk-service-actions">
                            <a class="hk-service-projects" href="/projects?filter=automation">View projects</a>
                            <a class="hk-service-more" href="/business-process-automation">Learn more</a>
                        </div>
                    </div>
                    <div class="hk-service-card">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_web.svg" alt="" width="44" height="44"/>
                            <h3>Custom Web Applications &amp; B2B Portals</h3>
                        </div>
                        <p class="hk-service-text">Customer portals, vendor platforms and internal tools built around how your business actually works, not how a template assumes it does.</p>
                        <div class="hk-service-actions">
                            <a class="hk-service-projects" href="/projects?filter=apps">View projects</a>
                            <a class="hk-service-more" href="/web-application-development">Learn more</a>
                        </div>
                    </div>
                    <div class="hk-service-card">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_ai.svg" alt="" width="44" height="44"/>
                            <h3>Secure In-House AI &amp; Data</h3>
                        </div>
                        <p class="hk-service-text">AI that works on your own ERP and CRM data, inside your control. Flag margin risks and surface bottlenecks without sending data to public tools.</p>
                        <div class="hk-service-actions">
                            <a class="hk-service-projects" href="/projects?filter=ai">View projects</a>
                            <a class="hk-service-more" href="/ai-solutions">Learn more</a>
                        </div>
                    </div>
                    <div class="hk-service-card">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_mobile.svg" alt="" width="44" height="44"/>
                            <h3>Mobile App Development</h3>
                        </div>
                        <p class="hk-service-text">Field apps, customer apps and on-site data capture for Android and iOS, connected to the systems your office already runs on.</p>
                        <div class="hk-service-actions">
                            <a class="hk-service-projects" href="/projects?filter=mobile">View projects</a>
                            <a class="hk-service-more" href="/mobile-application-development">Learn more</a>
                        </div>
                    </div>
                    <div class="hk-service-card">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_ux.svg" alt="" width="44" height="44"/>
                            <h3>UX &amp; Conversion-Focused Websites</h3>
                        </div>
                        <p class="hk-service-text">Websites that turn visitors into enquiries: clear navigation, focused calls to action and lead capture wired straight into your CRM.</p>
                        <div class="hk-service-actions">
                            <a class="hk-service-projects" href="/projects?filter=ux">View projects</a>
                            <a class="hk-service-more" href="/ux-ui-design">Learn more</a>
                        </div>
                    </div>
                    <div class="hk-service-card">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_cloud.svg" alt="" width="44" height="44"/>
                            <h3>Cloud-Managed Services</h3>
                        </div>
                        <p class="hk-service-text">Hosting, monitoring, backups and security for the systems you depend on, so your team never has to think about servers.</p>
                        <div class="hk-service-actions">
                            <a class="hk-service-projects" href="/projects?filter=cloud">View projects</a>
                            <a class="hk-service-more" href="/cloud-managed-services">Learn more</a>
                        </div>
                    </div>
                    <div class="hk-service-card">
                        <span class="hk-service-circle hk-deco" aria-hidden="true"/>
                        <div class="hk-service-head">
                            <img src="/website_hekau/static/src/img/icons/svc_rescue.svg" alt="" width="44" height="44"/>
                            <h3>Project Rescue &amp; Dedicated Developers</h3>
                        </div>
                        <p class="hk-service-text">Vendor walked away mid-build? We audit the code, finish what’s missing and stay on, or add experienced developers to your own team.</p>
                        <div class="hk-service-actions">
                            <a class="hk-service-projects" href="/projects?filter=rescue">View projects</a>
                            <a class="hk-service-more" href="/project-rescue">Learn more</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
